data.list<-data.list[data.list$protocol=="act",]

####################
##select the cells
####################
cells<-data.list[,c("file","genotype","age")]
cellname<-data.list$cell

####################
##recording and protocol parameters - adjust here
####################
channel<-"IN 0C"        #leak subtracted channel; raw channel would be "IN 0"
samplerate<-100000      #/s
volt<-10*(-8:6)         #-80 ... +60 mV
EK<- -75                #mV, K+ reversal potential of your solutions
step_start<-0.19        #s, start of the test pulse
step_end<-1.68          #s, end of the test pulse
peak_blank<-0.002       #s, skipped after the step to avoid the capacitive transient
ss_window<-0.05         #s, steady state window at the end of the step
base_window<-0.02       #s, baseline window in front of the step
smooth_ms<-0.5          #ms, boxcar for peak detection (patch data are noisy)
plot_fits<-TRUE         #print the Boltzmann fit of every patch

genotype_levels<-c("Kcna2+/P405L","Kcna2+/+")
genotype_colours<-c("blue","black")

##indices used in every sweep
base_ind<-(round((step_start-base_window)*samplerate)+1):(round(step_start*samplerate)+1)
peak_ind<-(round((step_start+peak_blank)*samplerate)+1):(round(step_end*samplerate)+1)
ss_ind<-(round((step_end-ss_window)*samplerate)+1):(round(step_end*samplerate)+1)
smooth_n<-round(smooth_ms/1000*samplerate)

##membrane capacitance from the abf header (amplifier telegraph, per channel)
get_membrane_cap<-function(data,ch){
  cm<-NA
  if(!is.null(data$sections$ADCsec)&&length(data$sections$ADCsec)>=ch){
    cm<-data$sections$ADCsec[[ch]]$fTelegraphMembraneCap
  }
  if(is.null(cm)) cm<-NA
  if(!is.na(cm)){
    if(cm<=0){cm<-NA                  #telegraph off -> no value stored
    } else if(cm<1e-6){cm<-cm*1e12}   #stored in F -> pF
  }
  cm
}

##Boltzmann as in KCNA1_act.R
activation <- function(g, Vhalf, k, c, V) (g/(1+exp((Vhalf-V)/k))+c)

##########
#prepare everything for the loop
##########
sweep<-data.frame(matrix(ncol = 11, nrow = 0))
colnames(sweep)<-c("cell","genotype","age","voltage","peak","peak_dens",
                   "steady","ss_ratio","inactivation","cond","cond_norm")

patch<-data.frame(matrix(ncol = 9, nrow = 0))
colnames(patch)<-c("cell","genotype","age","Cm","Imax","Imax_dens","gmax","Vhalf","k")

########
#loop starts here
#######
for ( i in 1:length(cellname)){
  #select the patch
  curr_cell<-cells[i,]
  #read data of one patch
  data<-readABF(curr_cell$file)
  #How many sweeps
  sweepnr<-length(data$data)
  #select the channel; ch+1 is the column in as.data.frame(data,sweep=ii)
  ch<-which(trimws(data$channelNames)==channel)
  if(length(ch)==0) stop(paste0("channel ",channel," not found in ",curr_cell$file))

  #membrane capacitance, fall back to the column Cm of the excel sheet
  cm<-get_membrane_cap(data,ch)
  if(is.na(cm)&&!is.null(data.list$Cm)) cm<-data.list$Cm[i]

  #prepare to store the sweep parameters temporarly
  curr<-rep(NA, sweepnr)
  ss<-rep(NA, sweepnr)

  #do the sweep analysis
  for (ii in 1:sweepnr){
    #read the sweep data; same as as.data.frame(data,sweep=ii)[,ch+1], but faster
    trace<-data$data[[ii]][,ch]
    #baseline in front of the step
    trace<-trace-mean(trace[base_ind])
    #boxcar filter, only used for the peak
    trace_s<-as.numeric(stats::filter(trace,rep(1/smooth_n,smooth_n)))
    #peak current during the step
    curr[ii]<-max(trace_s[peak_ind],na.rm=TRUE)
    #steady state current at the end of the step
    ss[ii]<-mean(trace[ss_ind])
  }

  #conductance, only where there is outward driving force
  cond<-curr/(volt[1:sweepnr]-EK)
  cond[volt[1:sweepnr]<=EK]<-NA
  cond_norm<-cond/max(cond,na.rm=TRUE)

  #store the sweep values of this patch
  sweep<-rbind(sweep,
               data.frame("cell"=rep(cellname[i],sweepnr),
                          "genotype"=rep(curr_cell$genotype,sweepnr),
                          "age"=rep(curr_cell$age,sweepnr),
                          "voltage"=volt[1:sweepnr],
                          "peak"=curr,
                          "peak_dens"=curr/cm,
                          "steady"=ss,
                          "ss_ratio"=ss/curr,
                          "inactivation"=1-ss/curr,
                          "cond"=cond,
                          "cond_norm"=cond_norm))

  #Boltzmann fit of this patch
  sweep.fit<-data.frame("voltage"=volt[1:sweepnr],"conductance"=cond_norm)
  sweep.fit<-sweep.fit[!is.na(sweep.fit$conductance),]
  fit_coef<-c("myg"=NA,"myVhalf"=NA,"myk"=NA,"myc"=NA)
  model<-tryCatch({
    SS<-getInitial(conductance~SSlogis(voltage,alpha,xmid,scale),data=sweep.fit)
    nls(conductance ~ activation(myg,myVhalf,myk,myc,voltage), data=sweep.fit,
        start=list(myg=SS["alpha"],myVhalf=SS["xmid"],myk=SS["scale"],myc=0),
        control = nls.control(maxiter = 400))
  }, error=function(e){warning(paste0("no fit for ",cellname[i],": ",conditionMessage(e)));NULL})

  if(!is.null(model)){
    fit_coef<-coef(model)
    if(plot_fits){
      curve_df <- data.frame("voltage" = seq(min(sweep.fit$voltage), max(sweep.fit$voltage),
                                             length.out = 100))
      curve_df$prob <- predict(model, curve_df, type = "response")
      print(
        ggplot(curve_df, aes(x = voltage, y = prob)) +
          geom_line() +
          geom_point(data=sweep.fit,aes(x=voltage,y=conductance))+
          ggtitle(cellname[i])+
          theme_classic())
    }
  }

  #store the patch values
  patch<-rbind(patch,
               data.frame("cell"=cellname[i],
                          "genotype"=curr_cell$genotype,
                          "age"=curr_cell$age,
                          "Cm"=cm,
                          "Imax"=curr[which(volt==60)],
                          "Imax_dens"=curr[which(volt==60)]/cm,
                          "gmax"=fit_coef["myg"],
                          "Vhalf"=fit_coef["myVhalf"],
                          "k"=fit_coef["myk"]))

  print(paste0("finished analysis of ",curr_cell$file))
}

